{
  "name": "rentos-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "bootstrap-owner": "tsx src/scripts/bootstrap-owner.ts",
    "test": "tsx --test test/booking-pricing.test.ts test/booking-transactions.integration.test.ts",
    "test:integration": "tsx --test test/booking-transactions.integration.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.1.0",
    "jose": "^6.2.12",
    "mongoose": "^8.12.1",
    "multer": "^2.4.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.2"
  }
}
